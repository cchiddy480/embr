rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public trip guides: get by known id only, never enumerable.
    match /client-configs/{tripId} {
      allow get: if true;
      allow list: if false;
      allow write: if false; // writes only via firebase-admin (bypasses rules)
    }

    // Live guest-facing updates, scoped per trip. Written only via firebase-admin.
    match /client-configs/{tripId}/updates/{updateId} {
      allow get, list: if true;
      allow write: if false;
    }

    // Access-code -> tripId pointer. Same get-only, no-list posture.
    match /access-codes/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Everything sensitive: no client access at all, in either direction.
    // (edit-token hashes, planner emails, Stripe IDs, paid state)
    match /private/{tripId} {
      allow read, write: if false;
    }

    // Stripe webhook idempotency ledger.
    match /stripe-events/{eventId} {
      allow read, write: if false;
    }

    // Prospect-demo / /try lead tracking.
    match /leads/{leadId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
